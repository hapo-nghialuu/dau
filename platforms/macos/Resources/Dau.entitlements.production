<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CGEventTap + Accessibility require an unsandboxed process. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- Intentionally minimal:
	     - no get-task-allow
	     - no allow-jit / allow-unsigned-executable-memory / disable-library-validation
	     - no apple-events until product code proves it is required
	     Static libdau_core.a does not justify JIT or unsigned-exec entitlements. -->
</dict>
</plist>
